#!/bin/bash
# ELF -> Temp Binary -> Hex -> Truncate to Depth

# The simulator calls this script like: 
# elf2hex <width> <depth> <elf_file>
# $1 = Width (e.g., 64)
# $2 = Depth (e.g., 2048 or 64)
# $3 = ELF File

WIDTH=$1
DEPTH=$2
ELF_FILE=""

# Find the .elf file in the arguments (it might not be $3 in all cases)
for arg in "$@"
do
    if [[ $arg == *.elf ]]; then
        ELF_FILE=$arg
    fi
done

if [[ -z "$ELF_FILE" ]]; then
    echo "Error: No .elf file found" >&2
    exit 1
fi

MEM_FILE="${ELF_FILE}.memfile"
BIN_TEMP="${ELF_FILE}.temp.bin"

# 1. Convert ELF to Binary (Temp file)
riscv64-unknown-elf-objcopy -O binary --adjust-vma=-0x80000000 "$ELF_FILE" "$BIN_TEMP"

# 2. Convert to Hex

if [[ -n "$DEPTH" && "$DEPTH" =~ ^[0-9]+$ ]]; then
    od -An -t x8 -w8 -v "$BIN_TEMP" | head -n "$DEPTH" > "$MEM_FILE"
    echo "Created $MEM_FILE (Truncated to $DEPTH lines)"
else
    # Fallback if no depth provided
    od -An -t x8 -w8 -v "$BIN_TEMP" > "$MEM_FILE"
    echo "Created $MEM_FILE (No depth limit)"
fi

# 4. Cleanup
rm "$BIN_TEMP"
